{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/operations",
      "destination": "/operations.html"
    },
    {
      "source": "/portal/operations",
      "destination": "/operations.html"
    },
    {
      "source": "/client",
      "destination": "/client.html"
    },
    {
      "source": "/portal/client",
      "destination": "/client.html"
    },
    {
      "source": "/portal",
      "destination": "/client.html"
    },
    {
      "source": "/fundraising",
      "destination": "/fundraising.html"
    },
    {
      "source": "/schemes",
      "destination": "/fundraising.html"
    },
    {
      "source": "/admin/schemes",
      "destination": "/fundraising_admin.html"
    },
    {
      "source": "/fundraising-admin",
      "destination": "/fundraising_admin.html"
    },
    {
      "source": "/fundraising_admin",
      "destination": "/fundraising_admin.html"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
