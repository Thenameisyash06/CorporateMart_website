# Server Port
PORT=5000

# Application URL (used for email and notification links)
APP_URL=http://localhost:5000

# MongoDB URI (Leave empty to use local JSON file storage)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/corporatemart?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Initial Visitor Counter (Optional)
INITIAL_VISITOR_COUNT=29

# Web Push Notifications (Generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@corporatemart.in

# Email SMTP Settings (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Corporate Mart Desk <no-reply@corporatemart.in>"

# Razorpay Payment Gateway (Optional for payment processing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
