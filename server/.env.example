# Server Port
PORT=5000

# Application URL (used for email and notification links)
APP_URL=http://localhost:5000

# MongoDB URI (Leave empty to use local JSON file storage)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/corporatemart?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Initial Visitor Counter (Optional)
INITIAL_VISITOR_COUNT=29

# Web Push Notifications (Generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@corporate-mart.com

# Email Service Option A: Microsoft Graph API OAuth2 (Recommended - Azure App Registration)
MICROSOFT_CLIENT_ID=your_azure_client_id_here
MICROSOFT_CLIENT_SECRET=your_azure_client_secret_here
MICROSOFT_TENANT_ID=your_azure_tenant_id_here
MICROSOFT_EMAIL=Admin@corporate-mart.com
ADMIN_EMAIL=Admin@corporate-mart.com

# Email Service Option B: SMTP Fallback (Nodemailer)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=Admin@corporate-mart.com
SMTP_PASS=
EMAIL_FROM="Corporate Mart" <Admin@corporate-mart.com>

# Razorpay Payment Gateway (Optional for payment processing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
